# Optional: defaults to the published R2 release in deployment/asset-release.json.
VITE_ASSET_BASE_URL=
# Optional build-only fallback when Cloudflare challenges the custom CDN.
# The published release's fallback is automatic; custom releases must supply theirs.
ASSET_CHECK_BASE_URL=
ASSET_CHECK_ORIGIN=https://mcviewer.riyo.me
# Asset maintainers only. Never put credentials in VITE_* variables.
ASSET_VERSION=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PROFILE=minecraft-assets
