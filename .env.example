# Empty means local generated assets for npm run dev / npm run build.
# Vercel requires a published, immutable HTTPS asset URL.
VITE_ASSET_BASE_URL=
# Publishing only: do not put any R2 credentials in VITE_* variables.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PROFILE=minecraft-assets
ASSET_CHECK_ORIGIN=https://mcviewer.riyo.me
