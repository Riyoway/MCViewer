{
  "name": "minecraft-nostalgia-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "tsc --noEmit && tsx scripts/hosting.ts verify --vercel && vite build --mode vercel",
    "hosting:report": "tsx scripts/hosting.ts report",
    "assets:publish": "tsx scripts/hosting.ts publish",
    "assets:verify": "tsx scripts/hosting.ts verify",
    "preview": "vite preview --host 127.0.0.1",
    "assets": "tsx scripts/prepare.ts",
    "weather-assets": "tsx scripts/weather-assets.ts",
    "ui-assets": "tsx scripts/ui-assets.ts",
    "ui-language": "tsx scripts/ui-language.ts",
    "building-assets": "tsx scripts/building-assets.ts",
    "particle-assets": "tsx scripts/particle-assets.ts",
    "fluid-assets": "tsx scripts/fluid-assets.ts",
    "menu-assets": "tsx scripts/viewer-menu-assets.ts",
    "viewer-data": "tsx scripts/viewer-data.ts",
    "test": "tsx tests/check.ts && tsx tests/building.ts && tsx tests/viewer.ts && tsx tests/language.ts && tsc --project tsconfig.hosting.json && tsx tests/hosting.ts"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "fflate": "^0.8.2",
    "minecraft-data": "^3.100.0",
    "prismarine-nbt": "^2.7.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
